AGENT_SERVICE_API_KEY=
SMARTHUB_INTERNAL_BASE_URL=http://host.docker.internal:8081
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_MEMORY_MODEL=qwen-plus
DASHSCOPE_PROFILE_MODEL=qwen-plus
VECTOR_THREAD_POOL_WORKERS=4
DASHSCOPE_ROUTER_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
REDIS_URL=redis://host.docker.internal:6379/0
MILVUS_URI=http://milvus-standalone:19530
MILVUS_COLLECTION=smarthub_customer_knowledge
KNOWLEDGE_DIR=/knowledge/customer-service
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATE_K=12
RETRIEVAL_LEXICAL_SCAN_LIMIT=500
RETRIEVAL_MIN_SCORE=0.55
FAQ_MAX_RETRIEVAL_ATTEMPTS=2
MERCHANT_FAQ_COLLECTION=smarthub_merchant_faq
# Same independent internal index-worker secret on Java and the worker (>=32 chars).
FAQ_INDEX_SERVICE_KEY=
RUN_TIMEOUT_SECONDS=60
ACTION_CONFIRMATION_TTL_SECONDS=600
MAX_TOOL_CALLS=8
MAX_TOOL_CALLS_PER_TASK=4
MAX_AGENT_ACTIVATIONS=3
MAX_PARALLEL_AGENTS=2
MAX_EXECUTION_WAVES=3
MAX_SUPERVISOR_REPLANS=1
KEYWORD_ROUTER_ENABLED=true
# Optional override; bundled app/routing/router_rules.yaml is used by default.
# KEYWORD_ROUTER_RULES_PATH=/app/app/routing/router_rules.yaml
